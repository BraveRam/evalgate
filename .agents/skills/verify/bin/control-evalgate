#!/usr/bin/env python3
"""
control-evalgate: Verification helper and lifecycle CLI for EvalGate.
Manages isolated development instances (FastAPI backend + Next.js client) and provides
read-only health diagnostics ('doctor') for browser-driven verification.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_API_PORT = 8000
DEFAULT_CLIENT_PORT = 3000
STATE_DIR = Path(".evalgate-verify")
PID_FILE = STATE_DIR / "running.json"
REPO_ROOT = Path(__file__).resolve().parents[4]


def check_url(url: str, timeout: float = 1.5) -> tuple[bool, int, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            data = resp.read().decode("utf-8", errors="replace")
            return True, resp.status, data
    except urllib.error.HTTPError as e:
        return False, e.code, str(e)
    except Exception as e:
        return False, 0, str(e)


def cmd_launch(args: argparse.Namespace) -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if PID_FILE.exists():
        print(f"Warning: {PID_FILE} already exists. Running doctor to check existing instances...")
        res = cmd_doctor(args)
        if res == 0:
            print("EvalGate is already up and healthy. Ready for driving.")
            return 0
        else:
            print("Existing instance is unhealthy or stale. Cleaning up before launch...")
            cmd_cleanup(args)

    api_port = args.api_port
    client_port = args.client_port

    log_dir = STATE_DIR / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    api_log = open(log_dir / "api.log", "w", encoding="utf-8")
    client_log = open(log_dir / "client.log", "w", encoding="utf-8")

    env = os.environ.copy()
    env["PYTHONUNBUFFERED"] = "1"

    print(f"Starting API backend on port {api_port}...")
    api_proc = subprocess.Popen(
        [
            "uv", "run", "python", "-m", "uvicorn", "evalgate.api.app:app",
            "--host", "127.0.0.1", "--port", str(api_port)
        ],
        cwd=str(REPO_ROOT),
        stdout=api_log,
        stderr=subprocess.STDOUT,
        env=env,
        start_new_session=True,
    )

    print(f"Starting Next.js Studio on port {client_port}...")
    client_env = env.copy()
    client_env["PORT"] = str(client_port)
    client_proc = subprocess.Popen(
        ["pnpm", "--filter", "@evalgate/client", "dev", "--port", str(client_port)],
        cwd=str(REPO_ROOT),
        stdout=client_log,
        stderr=subprocess.STDOUT,
        env=client_env,
        start_new_session=True,
    )

    state = {
        "api_pid": api_proc.pid,
        "client_pid": client_proc.pid,
        "api_port": api_port,
        "client_port": client_port,
        "start_time": time.time(),
        "api_url": f"http://127.0.0.1:{api_port}",
        "client_url": f"http://localhost:{client_port}",
    }
    PID_FILE.write_text(json.dumps(state, indent=2), encoding="utf-8")

    print("Waiting for instances to become ready...")
    ready = False
    deadline = time.time() + 45
    while time.time() < deadline:
        api_ok, _, _ = check_url(f"http://127.0.0.1:{api_port}/health")
        client_ok, _, _ = check_url(f"http://localhost:{client_port}")
        if api_ok and client_ok:
            ready = True
            break
        time.sleep(1)

    if ready:
        print("✓ EvalGate is ready:")
        print(f"  • API:    http://127.0.0.1:{api_port} (/health -> OK)")
        print(f"  • Studio: http://localhost:{client_port}")
        return 0
    else:
        print("✗ Timed out waiting for instances to become ready.")
        cmd_cleanup(args)
        return 1


def cmd_doctor(args: argparse.Namespace) -> int:
    if not PID_FILE.exists():
        print(f"Doctor FAIL: {PID_FILE} does not exist. (No verified instance launched)")
        return 1

    try:
        state = json.loads(PID_FILE.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"Doctor FAIL: Corrupt state file {PID_FILE}: {e}")
        return 1

    api_url = state.get("api_url", f"http://127.0.0.1:{DEFAULT_API_PORT}")
    client_url = state.get("client_url", f"http://localhost:{DEFAULT_CLIENT_PORT}")

    api_ok, status, body = check_url(f"{api_url}/health")
    if not api_ok or status != 200:
        print(f"Doctor FAIL: API at {api_url}/health returned status {status}")
        return 1

    client_ok, status, _ = check_url(client_url)
    if not client_ok or status != 200:
        print(f"Doctor FAIL: Client Studio at {client_url} returned status {status}")
        return 1

    print("Doctor PASS: EvalGate backend and frontend are healthy.")
    print(f"  API:    {api_url} (HTTP 200)")
    print(f"  Studio: {client_url} (HTTP 200)")
    return 0


def cmd_cleanup(args: argparse.Namespace) -> int:
    if not PID_FILE.exists():
        print("Cleanup: No active PID state file found.")
        return 0

    try:
        state = json.loads(PID_FILE.read_text(encoding="utf-8"))
    except Exception:
        state = {}

    for name, pid in [("API", state.get("api_pid")), ("Client", state.get("client_pid"))]:
        if pid:
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
                print(f"Terminated {name} process group (PID {pid})")
            except (ProcessLookupError, PermissionError):
                try:
                    os.kill(pid, signal.SIGTERM)
                    print(f"Terminated {name} process (PID {pid})")
                except Exception:
                    pass
            except Exception as e:
                print(f"Note: Could not kill {name} PID {pid}: {e}")

    PID_FILE.unlink(missing_ok=True)
    print("Cleanup complete: PID state file removed. Evidence/artifacts preserved.")
    return 0


def main() -> None:
    parser = argparse.ArgumentParser(description="EvalGate Verification Lifecycle Controller")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    launch_p = subparsers.add_parser("launch", help="Start isolated backend & frontend instances")
    launch_p.add_argument("--api-port", type=int, default=DEFAULT_API_PORT, help="Port for FastAPI")
    launch_p.add_argument("--client-port", type=int, default=DEFAULT_CLIENT_PORT, help="Port for Next.js")

    subparsers.add_parser("doctor", help="Check health of running instances")
    subparsers.add_parser("cleanup", help="Tear down instances started by launch")

    args = parser.parse_args()
    if args.subcommand == "launch":
        sys.exit(cmd_launch(args))
    elif args.subcommand == "doctor":
        sys.exit(cmd_doctor(args))
    elif args.subcommand == "cleanup":
        sys.exit(cmd_cleanup(args))


if __name__ == "__main__":
    main()
